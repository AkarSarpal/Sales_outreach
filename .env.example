# Required
LEMLIST_API_KEY=your_lemlist_api_key_here
LEMLIST_CAMPAIGN_ID=cam_your_campaign_id_here

# Free key — cuts NVD runtime from ~7min to ~40sec
# Request at: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# VirusTotal free tier (500 req/day) — tech stack hints from passive DNS/HTTP headers
# Fallback only: direct HTTP fingerprinting runs first (no key needed)
# Sign up at: https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# Optional — enables breach lookup per domain (~$4/mo)
# Purchase at: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# Censys API (deprecated — free programmatic access removed June 2026)
# Leave blank — pipeline uses Shodan InternetDB instead (free, no key required)
CENSYS_API_ID=
CENSYS_API_SECRET=

# Optional — for future Claude synthesis features
ANTHROPIC_API_KEY=

# --- Free sources that need NO key ---
# Shodan InternetDB  : internetdb.shodan.io/{ip} — live ports + CVE IDs per IP
# CISA KEV catalog   : cisa.gov/known-exploited-vulnerabilities-catalog — actively exploited CVEs
# Direct HTTP probe  : fetches domain headers + HTML for tech stack detection
# SSL Labs           : ssllabs.com — cached SSL grade + cert expiry
# Whois CLI          : system tool — domain age + registrar
